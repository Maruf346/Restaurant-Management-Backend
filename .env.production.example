SECRET_KEY=replace-with-production-secret-key
DEBUG=False
ALLOWED_HOSTS=api.example.com,example.com

BASE_URL=https://api.example.com/
FRONTEND_URL=https://app.example.com

REDIS_HOST=redis
REDIS_PORT=6379
USE_REDIS_CHANNELS=True

DB_ENGINE=django.db.backends.postgresql
DB_NAME=restaurant_db
DB_USER=restaurant_user
DB_PASSWORD=super-secure-password
DB_HOST=your-rds-host.amazonaws.com
DB_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=ProfitPlate <noreply@example.com>

CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
WEBSOCKET_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com,wss://app.example.com,wss://admin.example.com

USE_S3_MEDIA=True
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-media-bucket
AWS_S3_REGION_NAME=eu-north-1
